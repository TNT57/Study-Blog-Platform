# Copy this file to .env.local and change the values if you need to.
# Never commit .env.local: it can hold real passwords. (.gitignore blocks it.)

# The app's database (Docker: `pnpm db:up`).
DATABASE_URL=postgres://study:study@localhost:5432/study_blog

# The database the tests use. It is wiped on every test run, so it must end in "_test".
TEST_DATABASE_URL=postgres://study:study@localhost:5432/study_blog_test
